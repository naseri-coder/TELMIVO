# TEMPLATE ONLY. Copy outside Git and populate with real values through the approved secret process.
# Run preflight before any production action.
TELMIVO_ENV=production
TELMIVO_ENV_FILE=/secure/telmivo.env
SYNTHETIC_MODE=false
HTTP_ADDR=:8080

DATABASE_URL=postgresql://telmivo_runtime:REPLACE@db.example:5432/telmivo?sslmode=verify-full
MIGRATION_DATABASE_URL=postgresql://telmivo_migration:REPLACE@db.example:5432/telmivo?sslmode=verify-full
REDIS_URL=rediss://:REPLACE@redis.example:6380/0
NATS_URL=tls://nats.example:4222

TELMIVO_DOMAIN=app.example.com
# Replace the TEST-NET placeholder with the exact reverse-proxy peer CIDR.
TRUSTED_PROXY_CIDRS=192.0.2.1/32
MINIAPP_URL=https://app.example.com

BOT_TOKEN=REPLACE
GROUP_BOT_TOKEN=REPLACE
DOWNLOADER_BOT_TOKEN=REPLACE
WEBHOOK_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

CREDENTIAL_KEY_ID=primary-v2
CREDENTIAL_KEYRING=primary-v2=REPLACE;primary-v1=REPLACE
WEBHOOK_DIGEST_KEY=REPLACE

ADMIN_TELEGRAM_IDS=REPLACE
MEDIA_CONCURRENCY=2
MAX_MEDIA_BYTES=51380224
MEDIA_STORAGE_ROOT=/var/lib/telmivo/media
MEDIA_WORK_ROOT=/var/lib/telmivo/work

OBJECT_STORAGE_ENDPOINT=https://objects.example.com
OBJECT_STORAGE_BUCKET=telmivo-private
OBJECT_STORAGE_REGION=eu-central-1
OBJECT_STORAGE_ACCESS_KEY=REPLACE
OBJECT_STORAGE_SECRET_KEY=REPLACE

TELMIVO_BACKEND_IMAGE=registry.example/telmivo/backend@sha256:REPLACE
TELMIVO_MINIAPP_IMAGE=registry.example/telmivo/miniapp@sha256:REPLACE
TELMIVO_PROXY_IMAGE=registry.example/nginx-unprivileged@sha256:REPLACE
TELMIVO_POSTGRES_IMAGE=registry.example/postgres@sha256:REPLACE

TELMIVO_TLS_CERT=/secure/path/fullchain.pem
TELMIVO_TLS_KEY=/secure/path/privkey.pem
