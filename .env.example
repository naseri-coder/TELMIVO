# Isolated development only. Never point these URLs at production.
TELMIVO_ENV=development
SYNTHETIC_MODE=true
HTTP_ADDR=:8080
DATABASE_URL=postgres://telmivo_runtime:dev-runtime-only@postgres:5432/telmivo_dev?sslmode=disable
MIGRATION_DATABASE_URL=postgres://telmivo_migration:dev-migration-only@postgres:5432/telmivo_dev?sslmode=disable
REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222
MINIAPP_URL=http://localhost:5173
# R1 requires no real bot tokens. A locally chosen synthetic signing token can test login.
BOT_TOKEN=
GROUP_BOT_TOKEN=
DOWNLOADER_BOT_TOKEN=
WEBHOOK_SECRET=
ADMIN_TELEGRAM_IDS=
# Live environments only: base64 32-byte key supplied by a secret manager, never Git.
CREDENTIAL_KEY=
MEDIA_CONCURRENCY=2
# R4C object storage is used in production. Development/test use UPLOAD_STORAGE_ROOT unless these values are explicitly wired.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

UPLOAD_STORAGE_ROOT=/tmp/telmivo-uploader-storage
